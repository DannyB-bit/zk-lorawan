diff --git a/Include/cpython/pystate.h b/Include/cpython/pystate.h
index 628f2e0..72be552 100644
--- a/Include/cpython/pystate.h
+++ b/Include/cpython/pystate.h
@@ -177,6 +177,9 @@ struct _ts {
 
     int gilstate_counter;
 
+    /* Pins this thread state while PyEval_SaveThread() drops the GIL. */
+    _Atomic unsigned int gil_release_refs;
+
     PyObject *async_exc; /* Asynchronous exception to raise */
     unsigned long thread_id; /* Thread id where this tstate was created */
 
diff --git a/Python/ceval_gil.c b/Python/ceval_gil.c
index aacf2b5..fee76a4 100644
--- a/Python/ceval_gil.c
+++ b/Python/ceval_gil.c
@@ -4,6 +4,7 @@
 #include "pycore_ceval.h"         // _PyEval_SignalReceived()
 #include "pycore_pyerrors.h"      // _PyErr_GetRaisedException()
 #include "pycore_pylifecycle.h"   // _PyErr_Print()
+#include "pycore_pystate.h"       // HEAD_LOCK()
 #include "pycore_initconfig.h"    // _PyStatus_OK()
 #include "pycore_interp.h"        // _Py_RunGC()
 #include "pycore_pymem.h"         // _PyMem_IsPtrFreed()
@@ -723,12 +724,20 @@ _PyEval_SignalAsyncExc(PyInterpreterState *interp)
 PyThreadState *
 PyEval_SaveThread(void)
 {
+    /* Serialize with interpreter/thread-list teardown and pin the tstate
+       until drop_gil() has finished accessing it and its interpreter. */
+    HEAD_LOCK(&_PyRuntime);
     PyThreadState *tstate = _PyThreadState_SwapNoGIL(NULL);
     _Py_EnsureTstateNotNULL(tstate);
+    atomic_fetch_add_explicit(&tstate->gil_release_refs, 1,
+                              memory_order_acquire);
+    HEAD_UNLOCK(&_PyRuntime);
 
     struct _ceval_state *ceval = &tstate->interp->ceval;
     assert(gil_created(ceval->gil));
     drop_gil(ceval, tstate);
+    atomic_fetch_sub_explicit(&tstate->gil_release_refs, 1,
+                              memory_order_release);
     return tstate;
 }
 
diff --git a/Python/pystate.c b/Python/pystate.c
index 2ee16e3..5fd1af5 100644
--- a/Python/pystate.c
+++ b/Python/pystate.c
@@ -938,6 +938,8 @@ _PyInterpreterState_Clear(PyThreadState *tstate)
 
 
 static inline void tstate_deactivate(PyThreadState *tstate);
+static void tstate_delete_common(PyThreadState *tstate);
+static void free_threadstate(PyThreadState *tstate);
 static void zapthreads(PyInterpreterState *interp);
 
 void
@@ -956,17 +958,9 @@ PyInterpreterState_Delete(PyInterpreterState *interp)
         _PyEval_ReleaseLock(interp, NULL);
     }
 
-    zapthreads(interp);
-
-    _PyEval_FiniState(&interp->ceval);
-
-    // XXX These two calls should be done at the end of clear_interpreter(),
-    // but currently some objects get decref'ed after that.
-#ifdef Py_REF_DEBUG
-    _PyInterpreterState_FinalizeRefTotal(interp);
-#endif
-    _PyInterpreterState_FinalizeAllocatedBlocks(interp);
-
+    /* Detach both lists under head_mutex before freeing any tstate.  New
+       SaveThread pins serialize on this same mutex; existing pins are drained
+       below before tstate_delete_common() and free_threadstate(). */
     HEAD_LOCK(runtime);
     PyInterpreterState **p;
     for (p = &interpreters->head; ; p = &(*p)->next) {
@@ -977,19 +971,42 @@ PyInterpreterState_Delete(PyInterpreterState *interp)
             break;
         }
     }
-    if (interp->threads.head != NULL) {
-        Py_FatalError("remaining threads");
-    }
     *p = interp->next;
-
     if (interpreters->main == interp) {
         interpreters->main = NULL;
         if (interpreters->head != NULL) {
             Py_FatalError("remaining subinterpreters");
         }
     }
+    PyThreadState *zap_list = interp->threads.head;
+    interp->threads.head = NULL;
     HEAD_UNLOCK(runtime);
 
+    while (zap_list != NULL) {
+        PyThreadState *tstate = zap_list;
+        zap_list = tstate->next;
+        tstate->prev = NULL;
+        tstate->next = NULL;
+        while (atomic_load_explicit(&tstate->gil_release_refs,
+                                    memory_order_acquire) != 0) {
+            /* The active SaveThread releases this pin immediately after
+               drop_gil(); keep the atomic acquire in the wait loop. */
+            atomic_signal_fence(memory_order_seq_cst);
+        }
+        tstate_verify_not_active(tstate);
+        tstate_delete_common(tstate);
+        free_threadstate(tstate);
+    }
+
+    _PyEval_FiniState(&interp->ceval);
+
+    // XXX These two calls should be done at the end of clear_interpreter(),
+    // but currently some objects get decref'ed after that.
+#ifdef Py_REF_DEBUG
+    _PyInterpreterState_FinalizeRefTotal(interp);
+#endif
+    _PyInterpreterState_FinalizeAllocatedBlocks(interp);
+
     if (interp->id_mutex != NULL) {
         PyThread_free_lock(interp->id_mutex);
     }
@@ -1301,6 +1318,7 @@ init_threadstate(PyThreadState *tstate,
     // PyGILState_Release must not try to delete this thread state.
     // This is cleared when PyGILState_Ensure() creates the thread state.
     tstate->gilstate_counter = 1;
+    atomic_init(&tstate->gil_release_refs, 0);
 
     tstate->cframe = &tstate->root_cframe;
     tstate->datastack_chunk = NULL;
